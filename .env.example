# Salin file ini jadi ".env" lalu isi nilainya masing-masing.

# MongoDB (Atlas atau lokal)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/lexerium

# Google OAuth Client ID (lihat README.md bagian "Setup Google Login")
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# String acak & panjang untuk menandatangani sesi login (JANGAN dibagikan)
JWT_SECRET=ganti-dengan-string-acak-panjang-dan-rahasia

# Model AI teks & vision (sesuaikan dengan model yang tersedia di provider kamu)
AI_TEXT_MODEL=qwen/qwen-2.5-7b-instruct
AI_VISION_MODEL=qwen/qwen2.5-vl-7b-instruct

PORT=3000
